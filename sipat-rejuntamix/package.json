{
  "name": "sipat-rejuntamix",
  "version": "1.0.0",
  "description": "Ambiente de preparação da retrospectiva SIPAT RejuntaMix",
  "scripts": {
    "dev": "remotion studio src/index.ts --no-open --port=3000",
    "build": "remotion bundle src/index.ts --out-dir=previews/bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "test:ffmpeg": "python3 scripts/media.py smoke",
    "test:remotion": "node scripts/render-test.mjs",
    "test": "npm run doctor && npm run lint && npm run test:ffmpeg && npm run test:remotion",
    "media": "python3 scripts/media.py",
    "test:studio": "node scripts/check-studio.mjs"
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true
}
